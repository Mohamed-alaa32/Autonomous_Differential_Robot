<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomous_differential_rob</name>
  <version>1.0.0</version>
  <description>Autonomous Differential Robot for Autonomous Systems Course at Ain Shams University</description>
  <maintainer email="mohammed.alaa200080@gmail.com">mohamed_alaa</maintainer>
  <license>Apache-2.0</license>

  <!-- 🔹 Build System -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 🔹 Build Dependencies -->
  <build_depend>rosidl_default_generators</build_depend>


  <!-- 🔹 ROS 2 Core -->
  <depend>controller_manager</depend>
  <depend>gz_ros2_control</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <exec_depend>gz_ros2_control_demos</exec_depend>


  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>action_msgs</depend>

  <!-- 🔹 Launch -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ros2launch</depend>


  <!-- 🔹 Controllers and Plugins -->

  <depend>pluginlib</depend>
  <depend>boost</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>

  <!-- 🔹 Gazebo & Simulation -->

  <!-- 🔹 Robot Descriptions -->
  <depend>urdf</depend>
  <depend>xacro</depend>

 
  <!-- 🔹 ROSIDL -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- 🔹 Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
